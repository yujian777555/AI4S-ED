{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceQuery",
  "description": "Input for retrieve_evidence MCP tool",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "subqueries": {"type": "array", "items": {"type": "string"}},
        "top_k": {"type": "integer", "default": 5},
        "coverage_keys": {"type": "array", "items": {"type": "string"}},
        "required_coverage_keys": {"type": "array", "items": {"type": "string"}},
        "allowed_ref_ids": {"type": "array", "items": {"type": "string"}},
        "private_data_unauthorized": {"type": "boolean", "default": false}
      }
    }
  }
}
